# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# JWT 密钥 (必需)
SECRET_KEY=your-secret-key-here

# ==========================================
# Token 分工（两个都要配！）
# ==========================================

# HF_TOKEN: 仓库通行证（必留！）
# 用于：下载 RoBERTa 权重、私有 bert-moe.ckpt、嵌入模型
# 获取方式：https://huggingface.co/settings/tokens → Fine-grained → Read 权限
HF_TOKEN=your-hf-token-here

# SILICON_API_KEY: 大脑通行证（推荐）
# 用于：调用 SiliconFlow 上的 Phi-4 Mini 生成整改建议
# 获取方式：https://cloud.siliconflow.cn/account/ak
SILICON_API_KEY=your-siliconflow-api-key

# ==========================================
# LLM 模式配置（可选，默认 siliconflow）
# ==========================================
# "siliconflow" : SiliconFlow API（默认，推荐，稳定快速）
# "local"        : 本地 GGUF 模式
# "hf"           : HuggingFace Inference API（需 HF_TOKEN 有 Inference 权限）
LLM_MODE=siliconflow

# LLM 模型 ID（默认 Phi-4 Mini）
LLM_MODEL_ID=microsoft/Phi-4-mini-instruct
