# 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# JWT 密钥 (必需)
SECRET_KEY=your-secret-key-here

# HuggingFace Token (必需，用于下载模型和调用 Inference API)
HF_TOKEN=your-hf-token-here

# 分类模型仓库 (可选，默认: sybululu/bert-moe)
HF_REPO_ID=sybululu/bert-moe

# 启用 HuggingFace Inference API (设为 1 启用)
USE_HF_API=0

# HuggingFace Inference API 模型 (Phi-4 Mini)
HF_INFERENCE_MODEL=microsoft/phi-4-mini-instruct
